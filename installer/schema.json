{
  "version": 1,
  "silent": {
    "flag": "/S",
    "prefix": "/"
  },
  "pages": [
    {"id": "mode", "title": "What this PC does", "help": "Choose what this PC does: local only (no forge), a GitHub runner or a GitLab runner. Choose one, then select Next."},
    {"id": "folders", "title": "Folders", "help": "Type an install folder and a work folder. Each typed folder is checked when you select Next; an empty box is skipped."},
    {"id": "forge", "title": "Forge addresses and allow-lists", "help": "The GitHub or GitLab address (https:// only), the partner or organisation ID and the allow-list. An empty box is skipped."},
    {"id": "network", "title": "Proxy and DNS", "help": "Only if this PC needs them: a proxy address (http:// or https://) and DNS servers, separated by commas. An empty box is skipped."},
    {"id": "labview", "title": "LabVIEW", "help": "Type the LabVIEW version this PC uses. An empty box is skipped."},
    {"id": "image", "title": "NI docker image", "help": "Choose the container type, then the NI docker image version. The runner uses it; it is pulled at install time. (none) skips it."},
    {"id": "licences", "title": "Licence conditions", "only_when": "image_chosen", "help": "Shown because an NI docker image was chosen. Tick both licence boxes to continue."},
    {"id": "secrets", "title": "Add secrets", "interactive_only": true, "repeatable": true, "help": "Tokens and passwords are typed here only, never on the command line. Fill in only the ones you need; an empty box is skipped."}
  ],
  "inputs": [
    {"id": "mode", "label": "What this PC does", "kind": "choice", "page": "mode", "choices": ["local", "github", "gitlab"], "choice_labels": {"local": "Local only (no forge)", "github": "GitHub runner", "gitlab": "GitLab runner"}, "setter": "Runner_Set", "req": ["INST-REQ-020", "INST-REQ-034", "INST-REQ-035", "INST-REQ-036"]},
    {"id": "install_dir", "label": "Install folder", "kind": "path", "required": true, "page": "folders", "req": ["INST-REQ-021"]},
    {"id": "work_dir", "label": "Work folder", "kind": "path", "page": "folders", "req": ["INST-REQ-021"]},
    {"id": "github_url", "label": "GitHub address", "kind": "url", "https_only": true, "page": "forge", "req": ["INST-REQ-021"]},
    {"id": "gitlab_url", "label": "GitLab address", "kind": "url", "https_only": true, "page": "forge", "req": ["INST-REQ-021"]},
    {"id": "partner_id", "label": "Partner or organisation ID", "kind": "text", "page": "forge", "req": ["INST-REQ-021"]},
    {"id": "allow_list", "label": "Allow-list (comma separated)", "kind": "list", "page": "forge", "req": ["INST-REQ-021"]},
    {"id": "http_proxy", "label": "Proxy address", "kind": "url", "page": "network", "req": ["INST-REQ-021"]},
    {"id": "dns_servers", "label": "DNS servers (comma separated)", "kind": "list", "page": "network", "req": ["INST-REQ-021"]},
    {"id": "labview_version", "label": "LabVIEW version", "kind": "text", "page": "labview", "req": ["INST-REQ-021"]},
    {"id": "image_variant", "label": "NI docker image container type", "kind": "choice", "page": "image", "choices": ["windows", "linux"], "req": ["INST-REQ-021", "INST-REQ-022"]},
    {"id": "image_year", "label": "NI docker image version", "kind": "choice", "page": "image", "choices": ["2026q3", "2026q1patch2", "2026q1patch1", "2026q1", "2025q3patch1", "2025q3"], "req": ["INST-REQ-021", "INST-REQ-022"]},
    {"id": "ni_licence_held", "label": "Yes, we hold a development licence (NI licence conditions)", "kind": "licence", "page": "licences", "req": ["INST-REQ-018", "INST-REQ-073"]},
    {"id": "engine_licence_accepted", "label": "Yes, we accept the container engine licence conditions", "kind": "licence", "page": "licences", "req": ["INST-REQ-018", "INST-REQ-073"]},
    {"id": "github_token", "label": "GitHub registration token", "kind": "secret", "no_blank": true, "page": "secrets", "req": ["INST-REQ-076"]},
    {"id": "gitlab_token", "label": "GitLab runner token", "kind": "secret", "no_blank": true, "page": "secrets", "req": ["INST-REQ-076"]},
    {"id": "registry_password", "label": "Image registry password", "kind": "secret", "no_blank": true, "page": "secrets", "req": ["INST-REQ-076"]}
  ],
  "secrets_step": {
    "interactive_only": true,
    "repeatable": true,
    "key_scope": "per-pc",
    "on_repeat": "replace"
  },
  "secret_refusal": {
    "name_pattern": "TOKEN|SECRET|PASSW|PASSPHRASE|KEY|CREDENTIAL",
    "file_or_stdin_options": ["SECRETFILE", "SECRETS", "SECRETSTDIN", "STDIN"]
  },
  "exit_codes": {
    "ok": 0,
    "folder-descriptor-failed": 2,
    "bad-value": 30,
    "unknown-key": 31,
    "secret-on-command-line": 32,
    "secret-from-file-or-stdin": 33,
    "edition-refused": 34,
    "licence-not-accepted": 35,
    "image-not-pinned": 36,
    "state-not-writable": 37,
    "folder-not-ours": 39,
    "image-pull-failed": 46,
    "cmdline-too-long": 50
  },
  "editions": {
    "accepted_exact": ["Windows 11 Pro", "Windows 11 Enterprise"],
    "accepted_prefix": ["Windows Server 2022", "Windows Server 2025"]
  },
