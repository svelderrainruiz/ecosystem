{
  "$comment": "State file installer-state.json in the install folder (INST-REQ-039). Checked by installer/update.py validate_state.",
  "schema_version": 1,
  "type": "object",
  "required": ["schema_version", "installer_version"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "installer_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "mode": {"type": "string", "enum": ["github", "local", "gitlab"]},
    "forge_address": {"type": "string"}
  },
  "additionalProperties": false
}
